# Server-only credentials. Copy to an ignored .env and fill in real values.
NUXT_AI_GATEWAY_API_KEY=
NUXT_AUTH_USER=
NUXT_AUTH_PASSWORD=
NUXT_AUTH_SESSION_SECRET=

# PostgreSQL only. Use Railway's private URL inside Railway and a pooled/TLS URL
# when connecting from another serverless provider. No SQLite fallback exists.
DATABASE_URL=postgresql://localhost:5432/autoproductimagery
DATABASE_POOL_MAX=3

# Private Railway bucket credentials or service variable references.
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=images
S3_FORCE_PATH_STYLE=false

# Keep this below the hosting provider's maximum request duration.
NUXT_IMAGE_GENERATION_REQUEST_TIMEOUT_MS=270000
NUXT_IMAGE_GENERATION_TIMEOUT_MS=180000
NUXT_IMAGE_GENERATION_CONCURRENCY=3
NUXT_IMAGE_GENERATION_MAX_QUEUE=25

# Generated outputs only; uploads and history are preserved. Whole days; 0 disables cleanup.
# Configure on the daily retention worker. Lowering this also affects existing outputs.
GENERATED_IMAGE_RETENTION_DAYS=180
